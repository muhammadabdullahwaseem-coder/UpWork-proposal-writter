# ============================================================
# Streamlit Cloud Secrets — copy this as secrets.toml
# and fill in your actual API key.
# ============================================================
# Go to: share.streamlit.io → Your App → Settings → Secrets
# Paste the key you want to use (only one needed):

# Option 1: Groq (Free — recommended)
GROQ_API_KEY = "your_groq_api_key_here"

# Option 2: Google Gemini (Free tier)
# GEMINI_API_KEY = "your_gemini_api_key_here"

# Option 3: Anthropic Claude
# ANTHROPIC_API_KEY = "your_anthropic_api_key_here"

# Option 4: OpenAI
# OPENAI_API_KEY = "your_openai_api_key_here"
